<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAGE RETURN</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#070707;
    color:white;
    font-family:Arial,sans-serif;
}

header{
    min-height:100vh;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
    background:
    radial-gradient(circle at 80% 40%,#8b000055,transparent 35%),
    linear-gradient(135deg,#050505,#180000,#050505);
}

header:after{
    content:"";
    position:absolute;
    width:300px;
    height:300px;
    background:#ff000033;
    filter:blur(100px);
    right:-100px;
    top:30%;
}

.container{
    width:90%;
    max-width:1100px;
    margin:auto;
    position:relative;
    z-index:2;
}

.logo{
    position:absolute;
    top:25px;
    left:5%;
    font-size:20px;
    font-weight:bold;
    letter-spacing:4px;
    color:#ff2020;
}

.small{
    color:#ff2929;
    letter-spacing:5px;
    font-size:12px;
    font-weight:bold;
}

h1{
    font-size:clamp(60px,15vw,150px);
    line-height:.8;
    margin:25px 0;
    font-weight:1000;
    letter-spacing:-6px;
}

h1 span{
    color:#ff1515;
}

.hero-text{
    max-width:600px;
    color:#aaa;
    font-size:17px;
    line-height:1.7;
}

.buttons{
    display:flex;
    gap:12px;
 
